ine = partial participation (optional)" style="text;html=1;fontSize=12;fontStyle=0;fontColor=#333;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="1223.0" width="321.1" height="18.0" as="geometry"/></mxCell><mxCell id="c139" value="1 / N / M = cardinality ratio (maximum)" style="text;html=1;fontSize=12;fontStyle=0;fontColor=#333;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="1243.0" width="274.1" height="18.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>