# Copy this file to .env and fill in your local MySQL login.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=course_registration
PORT=3000

# Websites allowed to call this server from the browser (the GitHub Pages site).
CORS_ORIGINS=https://jagga-tech.github.io

# Cloud MySQL (for example Aiven). Leave these out for a local MySQL.
# DB_SSL=true
# DB_CA_PATH=./ca.pem
# Or paste the certificate itself: DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Create the tables and sample data automatically on first start if the database is empty.
# AUTO_INIT=true
